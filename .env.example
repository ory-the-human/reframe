# Password for the web UI (HTTP basic auth, any username). Strongly recommended:
# the UI can see the photos the frame is authorized for.
WEB_PASSWORD=

# Everything below can also be set from the web UI's Settings page, which
# overrides these values.

# Where photos come from (google_ambient) and where they go (cozyla_adb, folder, web).
SOURCE=google_ambient
FRAME=cozyla_adb
# For FRAME=folder: a path inside the container; mount it in docker-compose.yml.
FRAME_FOLDER=/frame

# Slideshow display (FRAME=web). Each screen can override these in its link.
# Seconds per photo.
DISPLAY_INTERVAL=15
# single | pair (two photos share the screen when they fit it better)
DISPLAY_LAYOUT=single
# auto | landscape | portrait | landscape-flipped | portrait-flipped
DISPLAY_ORIENTATION=auto
# yes | no
DISPLAY_SHUFFLE=yes

# Google Photos Ambient source. Needs a project accepted into the Google Photos
# partner program (docs/decisions.md).
# OAuth client of type "TVs and Limited Input devices" from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Name shown in Google Photos settings for this frame.
DEVICE_NAME=Cozyla frame

# The frame's adb-over-Wi-Fi address.
FRAME_ADDRESS=192.168.1.50:5555
