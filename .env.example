# Password for the web UI (HTTP basic auth, any username). Strongly recommended:
# the UI can see the photos the frame is authorized for.
WEB_PASSWORD=

# Everything below can also be set from the web UI's Settings page, which
# overrides these values.

# Where photos come from: google_ambient.
SOURCE=google_ambient

# Frames are added on the dashboard or with `cozysync frames add`. On first start,
# these create the first frame if set (FRAME: cozyla_adb, folder or web).
# FRAME_ADDRESS can list several Cozyla frames, comma-separated: one frame each.
#FRAME=cozyla_adb
#FRAME_ADDRESS=192.168.1.50:5555,192.168.1.51:5555
#FRAME_FOLDER=/frame

# How frames reach this server; written into kiosk frames as their slideshow
# link. Blank: the address the web UI was opened with.
#PUBLIC_URL=http://192.168.1.10:1992

# Default slideshow display for web frames. Each frame can override these, and
# each screen again in its link.
# Seconds per photo.
DISPLAY_INTERVAL=15
# pair (two photos share the screen when they fit it better) | single
DISPLAY_LAYOUT=pair
# auto | landscape | portrait | landscape-flipped | portrait-flipped
DISPLAY_ORIENTATION=auto
# yes | no
DISPLAY_SHUFFLE=yes
# What fills the space around a photo that doesn't fill the screen: blur | black
DISPLAY_FILL=blur

# Screen defaults for kiosk frames, applied by the agent app on the frame.
# always | the hours the screen is off, e.g. 23:00-07:00 (the frame's local time)
SCREEN_SCHEDULE=always
# yes | no: turn the screen off when the room is dark
SCREEN_DARK=yes
# Dark means below this many lux for this many seconds.
SCREEN_DARK_LUX=5
SCREEN_DARK_SECONDS=30

# Google Photos Ambient source. Needs a project accepted into the Google Photos
# partner program (docs/decisions.md).
# OAuth client of type "TVs and Limited Input devices" from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Name shown in Google Photos settings for this worker.
DEVICE_NAME=cozysync
